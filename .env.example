YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========== YouTube (ส่วน A) ==========
# คำค้นอย่างน้อย 5 คำ คั่นด้วย ,
YT_QUERIES=ข่าว,ฟุตบอล,เกม,รีวิวมือถือ,ท่องเที่ยว
# โจทย์กำหนดให้รันทุก 1 ชั่วโมง
YT_INTERVAL_MIN=60
# จำนวนหน้าสูงสุดต่อคำค้น (แต่ละหน้าใช้ 100 หน่วยโควตา)
YT_MAX_PAGES=2
# จำนวนวิดีโอยอดนิยมที่ดึงคอมเมนต์ (โจทย์ขออย่างน้อย 20)
YT_TOP_COMMENTS=20
# งบโควตาต่อวัน (โควตาจริง 10,000 เผื่อไว้ 10%)
YT_DAILY_BUDGET=9000

# ========== ข่าว (ส่วน B) ==========
# เช็คหน้าข่าวล่าสุดทุก 5 นาที (เป้า freshness ≤ 15 นาที)
NEWS_INTERVAL_MIN=5
# request สูงสุดต่อนาทีต่อเว็บ (เพดานของโจทย์คือ 20)
NEWS_MAX_RPM=12
# ระบุตัวตนบอทให้เว็บต้นทางรู้ว่าเป็นใคร ติดต่อได้ทางไหน
USER_AGENT=MiniDataCollector/1.0 (+contact: your-email@example.com)

# ========== แจ้งเตือน ==========
# ไม่ส่งแจ้งเตือนเรื่องเดิมซ้ำภายในกี่นาที
ALERT_COOLDOWN_MIN=30
YT_QUERIES=ข่าว|ข่าวด่วน|ข่าวล่าสุด,ฟุตบอล|เกม|รีวิวมือถือ

# ข่าวใหม่สูงสุดต่อรอบ (40 ข่าว x 5 วินาที = 200 วินาที < รอบละ 300 วินาที)
NEWS_MAX_ARTICLES=40